<?xml version="1.0" encoding="utf-8"?>
<!--
  Static Armada mark as a vector, translated from ArmadaCrest.tsx / public/logo.svg
  (128x128 viewport). Base for the animated splash icon (splash_logo_anim.xml),
  animatable via the named groups/paths below:
    - wave1..3Group : pivot at the mark's centerline, so each wave line can
                      sweep open horizontally (scaleX)
    - wave1..3      : the cyan wave lines (fade in with the sweep)
    - sailTrace     : stroke-only copy of the sail, drawn by trimPathEnd — this
                      is the "pen" that traces the outline, then fades out
    - sail          : the rose sail's fill (floods in behind the trace)
    - caret         : the waterline reflection (inks in last)
  Every animatable attribute rests at its *pre*-animation value here (alpha 0,
  scaleX a sliver, trimPathEnd 0) because splash_logo_anim.xml always runs; the
  final frame is the finished mark, which the splash holds until the WebView
  paints.
  Colors mirror the app's dark-theme tokens:
    primary 330 90% 62% -> #F84D96 (rose), accent2 180 90% 55% -> #1AE8E8 (cyan).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- The Android 12+ SplashScreen API masks windowSplashScreenAnimatedIcon
         to a circle ~2/3 the icon canvas. The mark is authored in a 128x128
         box that it nearly fills (the sail's tip and the bottom wave sit at the
         frame edge), so this outer group insets it 32 on every side into a 192
         viewport: the mark's ~120dp bounding circle then fits inside the ~128dp
         visible circle instead of being cropped. All child coordinates/pivots
         stay in the original 128 space. -->
    <group
        android:name="markGroup"
        android:translateX="32"
        android:translateY="32">

    <!-- Three cyan wave lines. Each sweeps open from x=64, the mark's
         centerline, which is also every line's own center. -->
    <group
        android:name="wave1Group"
        android:pivotX="64"
        android:pivotY="102.7"
        android:scaleX="0.15">
        <path
            android:name="wave1"
            android:pathData="M62.6,30 h2.8 v68 h-2.8 z"
            android:fillColor="#1AE8E8"
            android:fillAlpha="0" />
    </group>
    <group
        android:name="wave2Group"
        android:pivotX="64"
        android:pivotY="114.1"
        android:scaleX="0.15">
        <path
            android:name="wave2"
            android:pathData="M30,62.6 h68 v2.8 h-68 z"
            android:fillColor="#1AE8E8"
            android:fillAlpha="0" />
    </group>
    <group
        android:name="wave3Group"
        android:pivotX="64"
        android:pivotY="122.7"
        android:scaleX="0.15">
        <path
            android:name="wave3"
            android:pathData="M62.6,30 h2.8 v68 h-2.8 z"
            android:fillColor="#1AE8E8"
            android:fillAlpha="0" />
    </group>

    <!-- The rose sail's fill, flooding in behind the trace below it. -->
    <path
        android:name="sail"
        android:pathData="M64,10 L114,64 L64,118 L14,64 z M64,30 L94,64 L64,98 L34,64 z"
        android:fillType="evenOdd"
        android:fillColor="#F84D96"
        android:fillAlpha="0" />
    <!-- The tracing pen: same outline, stroke only (trimPath* applies to the
         stroke, so this copy must not carry a fill). -->
    <path
        android:name="sailTrace"
        android:pathData="M64,10 L114,64 L64,118 L14,64 z M64,30 L94,64 L64,98 L34,64 z"
        android:fillType="evenOdd"
        android:fillColor="#00000000"
        android:strokeColor="#F84D96"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:trimPathEnd="0" />
    <!-- Waterline reflection, inked in last. -->
    <path
        android:name="caret"
        android:pathData="M64,54 a10,10 0 1 0 0,20 a10,10 0 1 0 0,-20 z"
        android:fillColor="#F84D96"
        android:fillAlpha="0" />
    </group>
</vector>
