# /etc/wizardry-accounts/env — root:wizardry-accounts, mode 0640. install.sh writes this file
# and fills in ACCOUNT_PEPPER itself; edit the lines marked CHANGE. Meanings: docs/accounts.md.

# Written by install.sh. Never change it once anyone has an account: every account stops working.
ACCOUNT_PEPPER=

# CHANGE: the https origin this server is reached on. Key proofs must name it exactly.
ACCOUNT_PUBLIC_URL=https://accounts.example.com

# CHANGE: the web origins allowed to call it, comma-separated: where the Wizardry site is served.
# The phone and desktop apps call from https://localhost and capacitor://localhost; add them when those ship.
ACCOUNT_ALLOWED_ORIGINS=https://wizardry.example.com

ACCOUNT_DB=/var/lib/wizardry-accounts/accounts.db
HOST=127.0.0.1
PORT=8787
# nginx is the one proxy in front, and nginx.conf sets X-Forwarded-For itself.
ACCOUNT_TRUSTED_PROXIES=1

# CHANGE: how codes are sent. The mail server on the same machine takes local mail without a
# password; for a remote one use smtps://user:password@host:465.
SMTP_URL=smtp://127.0.0.1:25
MAIL_FROM=Wizardry <accounts@example.com>

# Optional: shared secret a members-only relay sends to ask "is this key a member's?".
# ACCOUNT_MEMBER_TOKEN=
